# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# The ghost's name, as it refers to itself in conversation and in its Discord presence
GHOST_NAME=Maynard Moonveil

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: restrict the ghost to specific channel IDs (comma-separated).
# Leave blank to let it haunt every channel it can see.
HAUNT_CHANNEL_IDS=

# Optional: guild IDs for instant slash-command sync / allow-list (comma-separated).
# DEV_GUILD_ID=
# ALLOWED_GUILD_IDS=
